<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

    <!--
      The Keyra SDK (PenguinConverters.Keyra*) is a proprietary, separately licensed
      component and is NOT published to nuget.org. Building PenguinConverters.Syntra.Core
      requires a Keyra licence and access to the private feed that serves it.

      Add the feed locally rather than committing credentials. Run "dotnet nuget add
      source" with the feed URL and your credentials; the exact command is documented in
      .github/CONTRIBUTING.md under "The Keyra SDK dependency".

      Solutions that do not reference Syntra.Core build against nuget.org alone.
    -->
  </packageSources>
</configuration>

<Project>
  <!--
    Database projects must not inherit this. Microsoft.Build.Sql picks its own framework
    (netstandard2.1 under "dotnet build", net472 under Visual Studio), but only when the
    property is empty - and Visual Studio then forces net472 regardless. Setting it here for
    a .sqlproj pins one side of that pair and leaves restore and build disagreeing, which is
    what produces NETSDK1005 and makes the Microsoft.SqlServer.Dacpacs.* packages, which carry
    no matching assets, report as missing.
  -->
  <PropertyGroup Condition=" '$(MSBuildProjectExtension)' != '.sqlproj' ">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Company>Penguin Converters AG</Company>
    <Authors>Syntra Team</Authors>
    <Product>Syntra</Product>
    <Copyright>Copyright (c) 2026 Penguin Converters AG</Copyright>
  </PropertyGroup>

  <!--
    Versioning has one source of truth: the release tag. CI passes -p:Version=<tag>, which is a
    global property and therefore wins over the fallback below - the fallback exists so that a
    local build produces something sane, never so that a release reads its version from a file
    somebody forgot to bump.

    AssemblyVersion is pinned and does not move with the release. It is the identity half of a
    strong name, so changing it per release would break every binding against these assemblies
    and defeat the point of signing them. It moves only on a deliberate major version.
    FileVersion and InformationalVersion carry the real number, which is what a support call
    reads off the file properties dialog; the SDK appends the commit to InformationalVersion.
  -->
  <PropertyGroup>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <!--
    Strong naming gives every assembly here a stable identity, which is what a connector loaded by
    name at runtime is resolved against and what an InternalsVisibleTo grant is checked against.

    The key is committed deliberately. A strong name is an identity, not a security boundary: it
    says which assembly this is, not who published it or that it is unmodified. That is
    Authenticode's job, and its key is hardware-held and never goes near this repository. Since
    .NET Core the runtime does not verify strong-name signatures when it loads an assembly, so
    holding this key grants no capability that building an unsigned assembly of the same name
    would not. Every .NET project that publishes its source does the same, the runtime itself
    included.

    It applies to test projects as well as shipping ones. A strong-named assembly can only open
    its internals to another assembly signed with the same key, and Consumer.AzureSQL grants
    exactly that to its test project.

    Database projects are excluded: Microsoft.Build.Sql produces a .dacpac, which carries no
    assembly identity to sign.
  -->
  <PropertyGroup Condition=" '$(MSBuildProjectExtension)' != '.sqlproj' ">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Syntra.snk</AssemblyOriginatorKeyFile>
    <SyntraPublicKey></SyntraPublicKey>
  </PropertyGroup>

  <!--
    A strong-named assembly may only open its internals to an assembly signed with the same key,
    and the grant has to name that key in full - the SDK does not infer it from the key the
    project is being signed with. Stamping it here means a project writes the grant as
    <InternalsVisibleTo Include="..." /> and gets the key without repeating it, so the next one
    added cannot forget it and break the build.
  -->
  <ItemDefinitionGroup Condition=" '$(SignAssembly)' == 'true' ">
    <InternalsVisibleTo>
      <Key>$(SyntraPublicKey)</Key>
    </InternalsVisibleTo>
  </ItemDefinitionGroup>

  <!--
    Assembly identity follows the folder, so a project called Provider.Tenable produces
    PenguinConverters.Syntra.Provider.Tenable.dll without saying so itself. Set here rather than
    in each project because the SDK's default is the bare project name: a new connector that
    simply forgot the property would ship as Provider.Tenable.dll, collide with anybody else's
    assembly of that name, and be loaded by an InstanceBuilder that asks for the long one.

    A project that needs a different name states it and wins, because this is evaluated before
    the project body. Host.Console does exactly that: an executable is a command somebody types.
    Directory.Build.targets refuses a library that tries the same.
  -->
  <PropertyGroup Condition=" '$(MSBuildProjectExtension)' != '.sqlproj' ">
    <AssemblyName>PenguinConverters.Syntra.$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>PenguinConverters.Syntra.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!--
    A lock file records the exact graph a restore resolved, transitive packages included, so a
    later restore reproduces it rather than re-resolving. Several references here float
    (10.0.*, 1.*), which means without this the packages compiled into a release need not be the
    ones anybody reviewed - a build a fortnight after the pull request can quietly differ.

    Locked mode is applied on a build server only, where CI is set. It refuses to restore
    anything the lock file does not already describe, so a package added without committing the
    updated lock file fails the build instead of being resolved silently. A developer adding a
    package locally is not obstructed; their restore updates the lock file, which is then part of
    the change under review.

    Database projects are excluded: Microsoft.Build.Sql resolves its own tooling, and pinning it
    here would describe a graph that has nothing to do with the product.
  -->
  <PropertyGroup Condition=" '$(MSBuildProjectExtension)' != '.sqlproj' ">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition=" '$(CI)' == 'true' ">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- NuGet package metadata: every project in this repository is independently publishable. -->
  <PropertyGroup>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/PenguinConverters/Syntra</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PenguinConverters/Syntra</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>iam;identity;access-management;automation;active-directory;entra-id;odata;synchronization</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Test projects are not published, so they expose no public API to document. Generating a
    documentation file for them only produces CS1591 noise on every [Test] method. This must
    come after the block above, which turns documentation on for everything.
  -->
  <PropertyGroup Condition=" $(MSBuildProjectName.EndsWith('.Tests')) ">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' And Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>

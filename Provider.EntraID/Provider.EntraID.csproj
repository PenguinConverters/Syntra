<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PenguinConverters.Syntra.Provider.EntraID</RootNamespace>
    <AssemblyName>PenguinConverters.Syntra.Provider.EntraID</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Syntra Team</Authors>
    <Company>Penguin Converters AG</Company>
    <Product>Syntra</Product>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Endpoints are configuration strings, not compile-time paths, so the generated request
      builders in Microsoft.Graph are unusable here and the typed model surface that comes with
      them would be dead weight. Kiota is what that SDK is built on: KiotaClientFactory assembles
      the same middleware pipeline - retry, redirect, parameter-name decoding, user agent -
      around a plain HttpClient.
    -->
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.0.0" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="2.0.0" />
    <PackageReference Include="Microsoft.Kiota.Authentication.Azure" Version="2.0.0" />
    <PackageReference Include="Azure.Identity" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>

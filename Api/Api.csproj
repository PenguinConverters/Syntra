<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PenguinConverters.Syntra.Api</RootNamespace>
    <AssemblyName>PenguinConverters.Syntra.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.*" />
    <!--
      Minimum 3.8.2: versions >= 3.2.0, < 3.8.2 write client secrets and certificate
      information to service logs (GHSA / Dependabot alert 1).
    -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!--
    Self-contained when a runtime identifier is given, so a deployed host needs no
    .NET runtime installed. It is conditional because a build without a RID - which
    is what CI and every local build does - cannot produce a self-contained app and
    would fail outright.

    Never trimmed: connectors are resolved by name through reflection, and the
    trimmer cannot see those references. It would remove them, and the failure
    would surface only at run time on a customer's server.
  -->
  <PropertyGroup Condition=" '$(RuntimeIdentifier)' != '' ">
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PenguinConverters.Syntra.Consumer.AzureSQL</RootNamespace>
    <AssemblyName>PenguinConverters.Syntra.Consumer.AzureSQL</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>Syntra Team</Authors>
    <Company>Penguin Converters AG</Company>
    <Product>Syntra</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

  <!--
    SqlStatementBuilder stays internal: generated T-SQL is an implementation detail, not part
    of the package surface. The test project asserts the generated text directly, since it is
    the only part of the bulk path verifiable without a live SQL Server.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="PenguinConverters.Syntra.Consumer.AzureSQL.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>

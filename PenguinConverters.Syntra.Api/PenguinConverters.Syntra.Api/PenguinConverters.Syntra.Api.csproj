<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PenguinConverters.Syntra.Api</RootNamespace>
    <AssemblyName>PenguinConverters.Syntra.Api</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="8.0.*" />
    <!--
      Minimum 3.8.2: versions >= 3.2.0, < 3.8.2 write client secrets and certificate
      information to service logs (GHSA / Dependabot alert 1).
    -->
    <PackageReference Include="Microsoft.Identity.Web" Version="3.8.*" />
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.*" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.*" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PenguinConverters.Syntra.Core\PenguinConverters.Syntra.Core\PenguinConverters.Syntra.Core.csproj" />
  </ItemGroup>

</Project>
